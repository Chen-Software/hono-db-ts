# ── Local Postgres development configuration ─────────────────────────────────
# ⚠️  LOCAL-ONLY — Postgres (postgres-js over TCP) CANNOT run inside a
# Cloudflare Worker. For Postgres on the Worker, use Neon + Hyperdrive instead
# (see `.env.example.neon` / `bun run deploy:neon`).
#
# Use this to develop / test against a local Postgres (`docker compose up -d`):
#   bun run --env-file=.env.dev.postgres dev   # run the local server
#   bun run db:migrate:postgres                # apply Postgres migrations
#
# Selected by `bun run dev` when `DATABASE_TYPE=postgres`.

# Dialect: "sqlite" | "postgres" | "neon" | "turso" | "d1"
DATABASE_TYPE=postgres

# Connection URL for Postgres (matches compose.yml: postgres/postgres @ :5432/mydb).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mydb

# Command run by the test runner (`bun run test`) before integration tests,
# ensuring the local Postgres is up. Leave unset to skip.
INTEGRATION_TEST_SETUP_SCRIPT=docker compose up -d
# Cap on how long the setup command may run (ms). Defaults to 120000.
INTEGRATION_TEST_SETUP_TIMEOUT=120000

# Optional — Postgres connection pool size (defaults to 10).
# DATABASE_POOL_SIZE=10
