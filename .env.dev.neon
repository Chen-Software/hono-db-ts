# ── Local Neon development configuration ─────────────────────────────────────
# ✅ Runs the app locally against your Neon (serverless Postgres) database.
# The Worker uses Neon via Hyperdrive; this is only for local dev.
#
# Selected by `bun run dev` when `.env` has `DATABASE_TYPE=neon`.
# Loaded explicitly as well:  bun run --env-file=.env.dev.neon dev

DATABASE_TYPE=neon

# Pooled connection string (recommended for app/HTTP usage locally).
# Get it from the Neon console (Dashboard → Connect) or `neon env pull`.
DATABASE_URL="postgresql://neondb_owner:<password>@<host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require"

# Direct (unpooled) connection string — use for migrations / long-running jobs.
# DATABASE_URL_UNPOOLED="postgresql://neondb_owner:<password>@<host>.<region>.aws.neon.tech/neondb?sslmode=require"

# Neon branch that was linked/pulled.
# NEON_BRANCH=production
