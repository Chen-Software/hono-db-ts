# ── Local Neon development configuration ─────────────────────────────────────
# ✅ Runs the app locally against a LOCAL Postgres (Neon Local / Docker), the
# closest local driver to Neon's serverless Postgres.
# The Worker uses Neon via Hyperdrive; this is only for local dev.
#
# `DATABASE_TYPE=postgres` because we're testing a LOCAL Postgres with the same
# postgres-js driver/schema Neon uses — no Neon-cloud client involved.
#
# Selected by `bun run dev` when `.env` has `DATABASE_TYPE=neon`. It also starts
# the local Postgres via `docker compose up -d` (see compose.yml).
#   bun run --env-file=.env.dev.neon dev

DATABASE_TYPE=postgres

# Local Postgres connection URL (matches compose.yml: postgres/postgres @ :5432/mydb).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mydb

# Command run by the test runner (`bun run test`) before integration tests,
# ensuring the local Postgres is up. Leave unset to skip.
INTEGRATION_TEST_SETUP_SCRIPT=docker compose up -d
# Cap on how long the setup command may run (ms). Defaults to 120000.
INTEGRATION_TEST_SETUP_TIMEOUT=120000

# Optional — Postgres connection pool size (defaults to 10).
# DATABASE_POOL_SIZE=10
