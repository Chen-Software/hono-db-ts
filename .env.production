# ── Production defaults (committed) ─────────────────────────────────────────
# Loaded automatically by Bun when NODE_ENV=production (`.env.production`),
# layered over `.env`. These feed the BUILD-TIME macros (`@/macros/envs`) that
# the worker and scripts are bundled with — so they control what ends up in the
# deployed artifact (e.g. which SQL backend is compiled in).

ENVIRONMENT=production
NODE_ENV=production

# ── SQL backend ──────────────────────────────────────────────────────────────
# Production deliberately targets a remote Cloudflare D1 database. The Worker
# reaches it through the `env.DB` binding (configured in wrangler.jsonc, which
# `wrangler.config.ts` generates with `d1_databases` when DATABASE_TYPE=d1).
# `DATABASE_URL` names the D1 database; the schema/migrations are applied via
# `wrangler d1 migrations apply` from `drizzle/`.
DATABASE_TYPE=d1
DATABASE_URL=d1:bbs-db

# ── Data Repository ──────────────────────────────────────────────────────────
DATA_STORE_TYPE=d1
DATA_STORE_URN=d1:bbs-db

# ── Deployed worker / infrastructure references ─────────────────────────────
# Not credentials — used to point the local tooling at the deployed worker.
# WORKER_URL=https://bbs-query.example.workers.dev
# R2_BUCKET=bbs-assets
D1_DATABASE=bbs-db
# ALLOWED_ORIGIN=https://example.com

# ── Telemetry ────────────────────────────────────────────────────────────────
# Set a non-empty OTLP endpoint to compile the metrics exporter into the build
# (see `otelEnabled()` macro). Keep the auth header secret — use a
# `.env.production.local` or a secret binding rather than committing it.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic …
# OTEL_SERVICE_NAME=artefact

# ── Better Auth (production) ─────────────────────────────────────────────────
# Public base URL the auth endpoints are served at — set to the deployed
# worker URL (e.g. https://bbs-query.<account>.workers.dev).
BETTER_AUTH_URL=https://bbs-query.example.workers.dev
# NEVER commit the secret. Set it as a Cloudflare secret binding:
#   wrangler secret put BETTER_AUTH_SECRET
# (the worker reads env.BETTER_AUTH_SECRET at runtime).
