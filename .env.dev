# ── Local development configuration (SQLite) ────────────────────────────────
# `bun:sqlite` is a local-dev-only driver — it cannot run inside a Cloudflare
# Worker (the Worker always uses the D1 binding via `src/worker.ts`).
# Loaded explicitly by the `dev` script: `bun run --env-file=.env.dev dev`.

DATABASE_TYPE=sqlite

# Local SQLite database file.
DATABASE_URL=sqlite.db
