# ── Local development configuration (SQLite) ────────────────────────────────
# ⚠️  LOCAL-ONLY — `bun:sqlite` CANNOT run inside a Cloudflare Worker.
# The Worker never uses this config: it reads its database binding at runtime
# (`env.HYPERDRIVE` -> Neon, else `env.DB` -> D1) via `src/worker.ts`.
# Loaded explicitly by the `dev` script: `bun run --env-file=.env.dev dev`.

DATABASE_TYPE=sqlite

# Local SQLite database file.
DATABASE_URL=sqlite.db
