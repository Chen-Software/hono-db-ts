# ── Neon (serverless Postgres) — template ───────────────────────────────────
# ✅ DEPLOYABLE to Cloudflare Workers via Hyperdrive (see `bun run deploy:neon`,
# which uses the `neon` wrangler env WITH a HYPERDRIVE binding).
#
# Copy this file to `.env` and fill in your real values, e.g.:
#   cp .env.example.neon .env
#
# Then use it:
#   - Deploy:   bun run deploy:neon
#   - Local DB: bun run dev  (dev uses `.env.dev.neon` → a local Postgres)
#
# Get your values:
#   - Neon connection: get from the Neon console (Dashboard → Connect), or run
#       bunx neon link            # link this project to a Neon project
#       bunx neon env pull        # pull DATABASE_URL into .env
#   - Hyperdrive: create a Hyperdrive config pointing at your Neon (unpooled)
#     connection string, then copy its id:
#       bun x wrangler hyperdrive create neon-hyperdrive \
#         --connection-string="postgresql://<user>:<pass>@<host>.region.aws.neon.tech/<db>"
#       bun x wrangler hyperdrive list     # copy the returned id → HYPERDRIVE_ID
#
# `neon` is treated as a Postgres dialect at build time (see src/db/index.ts),
# so it uses the same postgres-js driver and schema as `postgres`.

DATABASE_TYPE=neon

# Hyperdrive id — REQUIRED for `bun run deploy:neon`. The build generates
# wrangler.jsonc with this under `env.neon.hyperdrive[].id`.
HYPERDRIVE_ID=REPLACE_WITH_YOUR_HYPERDRIVE_ID

# D1 database id — only needed if you also deploy the D1 worker (`bun run deploy`).
# D1_DATABASE_ID=REPLACE_WITH_YOUR_D1_DATABASE_ID

# Pooled connection string (recommended for app/HTTP usage locally).
# DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"

# Direct (unpooled) connection string — use for migrations / long-running jobs,
# and for the Hyperdrive connection-string when creating the Worker binding.
# DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require"

# Neon branch that was linked/pulled.
# NEON_BRANCH=production
