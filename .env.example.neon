# ── Neon (serverless Postgres) — template ───────────────────────────────────
# Copy to `.env.neon` (gitignored) and fill in your real Neon connection string.
# Get it from the Neon console (Dashboard → Connect), or run:
#   bunx neon link            # link this project to a Neon project
#   bunx neon env pull        # pull DATABASE_URL into .env
#   cp .env.example.neon .env.neon
#
# `neon` is treated as a Postgres dialect at build time (see src/db/index.ts),
# so it uses the same postgres-js driver and schema as `postgres`.

DATABASE_TYPE=neon

# Pooled connection string (recommended for app/HTTP usage).
# DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"

# Direct (unpooled) connection string — use for migrations / long-running jobs.
# DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require"

# Neon branch that was linked/pulled.
# NEON_BRANCH=production
