# ── Local D1 development configuration ───────────────────────────────────────
# ⚠️  LOCAL-ONLY — D1 is a Cloudflare Worker binding with no local driver, so
# this dev config uses **`sqlite`** as the closest local equivalent.
# The Worker still uses the real D1 binding (`env.DB`) when deployed.
#
# Selected by `bun run dev` when `DATABASE_TYPE=d1`.
#   bun run --env-file=.env.dev.d1 dev

DATABASE_TYPE=sqlite

# Local SQLite database file.
DATABASE_URL=sqlite.db
