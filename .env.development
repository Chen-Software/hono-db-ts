# ── Shared development defaults (committed) ─────────────────────────────────
# Loaded automatically by Bun when NODE_ENV=development (`.env.development`),
# layered over `.env`. Override anything local in `.env.development.local`
# (gitignored) — never here.

ENVIRONMENT=development
NODE_ENV=development

# ── SQL backend: local dev uses bun:sqlite (in-memory) ──────────────────────
DATABASE_TYPE=sqlite
DATABASE_URL=:memory:

# ── Data Repository ──────────────────────────────────────────────────────────
DATA_STORE_TYPE=sqlite-db
DATA_STORE_URN=:memory:

# ── Data Modeling ────────────────────────────────────────────────────────────
DATA_MODEL_GENERATE_TARGET=class,type,json-schema,sql-table,sql-migrate,sql-seed
DATA_MODEL_GENERATE_OUTDIR=types

# ── Local dev server ─────────────────────────────────────────────────────────
PORT=3000

# ── Telemetry (leave unset to keep the exporter tree-shaken from the build) ─
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic …
# OTEL_SERVICE_NAME=artefact-dev
