# ── Local Turso development configuration ────────────────────────────────────
# ✅ LOCAL-ONLY — runs Turso embedded in a local file (SQLite-compatible).
# The Worker never uses this; it connects to Turso Cloud via `@libsql/client/http`.
#
# Selected by `bun run dev` when `.env` has `DATABASE_TYPE=turso` and
# `TURSO_URL` starts with `file://` (local). Loaded explicitly as well:
#   bun run --env-file=.env.dev.turso dev

DATABASE_TYPE=turso

# Local libSQL file URL (embedded file mode). A RELATIVE path works with the
# single-colon form `file:tursodb.db` (relative to the process CWD). Do NOT use
# `file://tursodb.db` — that's parsed as a URL host and fails.
TURSO_URL=file:tursodb.db

# Local TursoDB doesn't need an auth token.
# TURSO_AUTH_TOKEN=
