{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "movies-worker",
  "main": "src/main.ts",
  "compatibility_date": "2026-08-06",
  "alias": {
    // Keeps bun:sqlite out of the Worker bundle; the local bun entry stays isolated.
    "bun:sqlite": "./src/stubs/bun-sqlite.ts"
  },
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "movies-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  // "ai": {
  //   "binding": "AI"
  // },
  "observability": {
    "enabled": true
  }
}
