# Database dialect: "sqlite" | "postgres"
# Controls which Drizzle client the app creates (see src/db/index.ts).
DATABASE_TYPE=sqlite

# Connection URL for the selected dialect.
# SQLite:   DATABASE_URL=sqlite.db
# Postgres: DATABASE_URL=postgresql://user:password@localhost:5432/mydb
DATABASE_URL=sqlite.db

# Optional — Postgres connection pool size (defaults to 10).
# DATABASE_POOL_SIZE=10
