# Database dialect: "sqlite" | "postgres" | "d1"
# Controls which Drizzle client the app creates (see src/db/index.ts).
# This is read at BUILD TIME by the macros in src/macros/db.ts (local / CI only).
#   - d1       -> Cloudflare Worker binding (env.DB) — the production dialect (deployed)
#   - sqlite   -> local bun:sqlite driver (use `.env.dev` + `bun run dev`)
#   - postgres -> local postgres driver (use `.env.example.postgres` + `bun run dev:postgres`)
DATABASE_TYPE=d1

# Connection URL for the selected dialect.
# SQLite:   DATABASE_URL=sqlite.db
# Postgres: DATABASE_URL=postgresql://user:password@localhost:5432/mydb
# (Ignored for `d1` — the Worker reads the `env.DB` D1 binding directly.)
# DATABASE_URL=sqlite.db

# Optional — Postgres connection pool size (defaults to 10).
# DATABASE_POOL_SIZE=10
