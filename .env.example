# Database dialect: "sqlite" | "postgres" | "neon" | "d1"
# Controls which Drizzle client the app creates (see src/db/index.ts).
# This is read at BUILD TIME by the macros in src/macros/db.ts (local / CI only).
#
# LOCAL-ONLY (NOT available on Cloudflare Workers):
#   - sqlite   -> local bun:sqlite driver — CANNOT run in a Worker (use `.env.dev` + `bun run dev`)
#   - postgres -> local postgres driver   — CANNOT run in a Worker (use `.env.example.postgres` + `bun run dev:postgres`)
#
# DEPLOYABLE to Cloudflare Workers:
#   - d1       -> Cloudflare Worker D1 binding (env.DB). The default here.
#                 `bun run deploy` targets the top-level wrangler.jsonc env (D1, no Hyperdrive).
#   - neon     -> serverless Postgres via Hyperdrive on the Worker.
#                 Deploy with `bun run deploy:neon` (uses the `neon` wrangler env WITH Hyperdrive).
DATABASE_TYPE=d1

# Connection URL for the selected dialect.
# SQLite:   DATABASE_URL=sqlite.db
# Postgres: DATABASE_URL=postgresql://user:password@localhost:5432/mydb
# Neon:     DATABASE_URL=<your neon pooled connection string>
# (Ignored for `d1` — the Worker reads the `env.DB` D1 binding directly.)
# DATABASE_URL=sqlite.db

# Optional — Postgres/Neon connection pool size (defaults to 10).
# DATABASE_POOL_SIZE=10
