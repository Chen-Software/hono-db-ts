# ── Turso Cloud configuration — template ─────────────────────────────────────
# ✅ REMOTE edge SQLite database. Connect from local code with a URL + token.
#
# `DATABASE_TYPE` is the unified `turso`; `TURSO_URL` here is a `libsql://`
# cloud URL. (For local TursoDB use `.env.example.tursodb` with a `file:///` URL.)
#
# One-time setup:
#   turso auth login                     # link your Turso account
#   turso db create movies-db            # create a database
#   turso db show movies-db --url        # copy the URL → TURSO_URL
#   turso db tokens create movies-db     # copy the token → TURSO_AUTH_TOKEN
#
# Copy to `.env.turso` (gitignored) and fill in your values:
#   bun run dev:turso        # run the app against Turso Cloud
#   bun run db:migrate:turso # apply SQLite migrations to Turso Cloud
#   bun run test:turso       # run the endpoint tests against Turso Cloud

# Unified Turso dialect. `turso-cloud` / `tursodb` are also accepted aliases.
DATABASE_TYPE=turso

# Connection URL (from `turso db show <db> --url`).
# e.g. libsql://movies-db-<org>.turso.io
TURSO_URL=libsql://REPLACE_WITH_YOUR_TURSO_URL

# Auth token (from `turso db tokens create <db>`).
TURSO_AUTH_TOKEN=REPLACE_WITH_YOUR_TURSO_AUTH_TOKEN
