# ── Postgres dialect configuration (template) ──────────────────────────────
# Use this to develop / test against a local Postgres.
# Copy to `.env` when you want to run the app against Postgres, or load it
# explicitly: `bun run --env-file=.env.example.postgres dev`.
#
# Unlike SQLite, `bun:sqlite` cannot run inside a Cloudflare Worker — the
# Worker always uses the D1 binding (`env.DB`) via `src/worker.ts`. Postgres is
# for **local development / testing only**.

# Dialect: "sqlite" | "postgres" | "d1"
DATABASE_TYPE=postgres

# Connection URL for Postgres (matches compose.yml: postgres/postgres @ :5432/mydb).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mydb

# Optional — Postgres connection pool size (defaults to 10).
# DATABASE_POOL_SIZE=10
