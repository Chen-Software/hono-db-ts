# ── Postgres dialect configuration (template) ──────────────────────────────
# ⚠️  LOCAL-ONLY — Postgres (postgres-js over TCP) CANNOT run inside a
# Cloudflare Worker. For Postgres on the Worker, use Neon + Hyperdrive instead
# (see `.env.example.neon` / `bun run deploy:neon`).
#
# Use this to develop / test against a local Postgres (`docker compose up -d`):
#   bun run --env-file=.env.example.postgres dev   # run the local server
#   bun run db:migrate:postgres                    # apply Postgres migrations

# Dialect: "sqlite" | "postgres" | "neon" | "d1"
DATABASE_TYPE=postgres

# Connection URL for Postgres (matches compose.yml: postgres/postgres @ :5432/mydb).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mydb

# Optional — Postgres connection pool size (defaults to 10).
# DATABASE_POOL_SIZE=10
