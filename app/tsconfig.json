{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"types": ["bun", "vite/client", "@cloudflare/workers-types"],
		"paths": {
			"@/*": ["../src/*"],
			"design-system/*": ["../design-system/*"]
		}
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"../src/**/*.ts"
	]
}
