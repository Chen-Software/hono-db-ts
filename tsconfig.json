{
	"compilerOptions": {
		// Environment setup & latest features
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "ESNext",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"allowJs": true,
		"types": ["bun"],

		// Bundler mode
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		// Path aliases
		"paths": {
			"@/*": ["./src/*"]
		},

		// ttsc transform plugins — applied by @ttsc/unplugin (see scripts/build.ts).
		// Runs the typia transformer during Bun.build / Vite / tests.
		"plugins": [
			{
				"transform": "typia/lib/transform"
			}
		],

		// Best practices
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,

		// Some stricter flags
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noPropertyAccessFromIndexSignature": true
	},
	// Explicit include — @ttsc/unplugin generates a temp tsconfig in /tmp that
	// `extends` this one; without `include`, TypeScript resolves the default
	// `["**/*"]` against the temp dir and finds no inputs (TS18003). Relative
	// `include` paths resolve against THIS file's location, so `src` etc. work.
	"include": [
		"src/**/*.ts",
		"scripts/**/*.ts",
		"app/**/*.ts",
		"app/**/*.tsx",
		"*.config.ts",
		"wrangler.config.ts",
		"panda.config.ts"
	]
}
