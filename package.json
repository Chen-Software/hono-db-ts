{
	"name": "artefact",
	"module": "src/main.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"fix": "bun run check",
		"check": "bun x @biomejs/biome check --fix .",
		"format": "bun x @biomejs/biome format --fix .",
		"lint": "bun x @biomejs/biome lint --fix .",
		"build": "bun run scripts/build.ts",
		"cf-build": "bun run scripts/build-cf.ts",
		"start": "bun run build && bun dist/main.js",
		"dev": "bun run scripts/build.ts --watch & sleep 2 && bun --hot dist/main.js",
		"cf-dev": "bun run cf-build && wrangler dev",
		"cf-deploy": "bun run cf-build && wrangler deploy",
		"db:create": "wrangler d1 create artefact-db",
		"db:migrate": "wrangler d1 migrations apply artefact-db",
		"db:migrate:local": "wrangler d1 migrations apply artefact-db --local"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@cloudflare/workers-types": "^4.20250808.0",
		"@ttsc/unplugin": "^0.25.0",
		"@types/bun": "latest",
		"ttsc": "^0.25.0",
		"vite": "^8.2.1",
		"wrangler": "^4.22.0"
	},
	"peerDependencies": {
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@hono/typia-validator": "^0.1.3",
		"@noble/hashes": "^2.3.0",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.1",
		"typia": "^13.2.0"
	}
}
