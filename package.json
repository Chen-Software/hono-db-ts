{
	"name": "artefact",
	"module": "src/main.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun run --env-file=.env.dev --watch src/main.ts",
		"dev:postgres": "bun run --env-file=.env.example.postgres --watch src/main.ts",
		"dev:wrangler": "bun x wrangler dev",
		"test": "bun --env-file=.env.dev test src/routes/movies.test.ts",
		"test:postgres": "bun --env-file=.env.example.postgres test src/routes/movies-postgres.test.ts",
		"db:generate:sqlite": "bun x drizzle-kit generate --config drizzle.config.sqlite.ts",
		"db:generate:postgres": "bun x drizzle-kit generate --config drizzle.config.postgres.ts",
		"db:generate": "bun run db:generate:sqlite && bun run db:generate:postgres",
		"db:migrate:sqlite": "bun run scripts/db-migrate.ts",
		"db:migrate:postgres": "bun run scripts/db-migrate-postgres.ts",
		"db:migrate": "bun run db:migrate:sqlite && bun run db:migrate:postgres",
		"db:push:sqlite": "bun x drizzle-kit push --config drizzle.config.sqlite.ts",
		"db:push:postgres": "bun x drizzle-kit push --config drizzle.config.postgres.ts",
		"db:seed": "bun run db:seed:bun && bun run db:seed:d1",
		"db:seed:bun": "bun run scripts/db-seed.ts",
		"db:seed:d1": "bun x wrangler d1 execute movies-db --remote --file ./drizzle/seed.sql",
		"build": "bun run scripts/build.ts",
		"deploy": "bun run build && bun x wrangler deploy",
		"deploy:dry-run": "bun run build && bun x wrangler deploy --dry-run",
		"worker:dev": "bun x wrangler dev",
		"worker:types": "bun x wrangler types",
		"fix": "bun run check",
		"check": "bun x @biomejs/biome check --fix .",
		"format": "bun x @biomejs/biome format --fix .",
		"lint": "bun x @biomejs/biome lint --fix .",
		"typecheck": "bun x tsc --noEmit",
		"start": "bun run src/main.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.5",
		"@cloudflare/workers-types": "^5.20260804.1",
		"@types/bun": "latest",
		"drizzle-kit": "^0.31.10",
		"wrangler": "^4.119.0"
	},
	"peerDependencies": {
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"hono": "^4",
		"postgres": "^3.4.9",
		"zod": "^4.4.3"
	}
}
