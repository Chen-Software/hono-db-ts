{
	"name": "artefact",
	"module": "src/main.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun run scripts/dev.ts",
		"test": "bun --env-file=.env.dev test src/routes/movies.test.ts",
		"test:postgres": "bun --env-file=.env.dev.postgres test src/routes/movies-postgres.test.ts",
		"test:neon": "bun --env-file=.env.neon test src/routes/movies-postgres.test.ts",
		"test:tursodb": "bun --env-file=.env.dev.turso test src/routes/movies-turso.test.ts",
		"test:turso": "bun --env-file=.env.turso test src/routes/movies-turso.test.ts",
		"db:generate:sqlite": "bun x drizzle-kit generate --config drizzle.config.sqlite.ts",
		"db:generate:postgres": "bun x drizzle-kit generate --config drizzle.config.postgres.ts",
		"db:generate": "bun run db:generate:sqlite && bun run db:generate:postgres",
		"db:migrate": "bun run scripts/db-migrate.ts",
		"db:push": "bun run scripts/db-push.ts",
		"db:seed": "bun run scripts/db-seed.ts",
		"build": "bun run scripts/build.ts",
		"generate:wrangler": "bun run wrangler.config.ts",
		"deploy": "bun run build && bun x wrangler deploy --env=\"\"",
		"deploy:neon": "bun run build && bun x wrangler deploy --env=neon",
		"deploy:turso": "bun run build && bun x wrangler deploy --env=turso",
		"deploy:dry-run": "bun run build && bun x wrangler deploy --env=\"\" --dry-run",
		"deploy:dry-run:neon": "bun run build && bun x wrangler deploy --env=neon --dry-run",
		"deploy:dry-run:turso": "bun run build && bun x wrangler deploy --env=turso --dry-run",
		"worker:dev": "bun x wrangler dev",
		"worker:types": "bun x wrangler types",
		"fix": "bun run check",
		"check": "bun x @biomejs/biome check --fix .",
		"format": "bun x @biomejs/biome format --fix .",
		"lint": "bun x @biomejs/biome lint --fix .",
		"typecheck": "bun x tsc --noEmit",
		"start": "bun run src/main.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.5",
		"@cloudflare/workers-types": "^5.20260804.1",
		"@types/bun": "latest",
		"drizzle-kit": "^0.31.10",
		"wrangler": "^4.119.0"
	},
	"peerDependencies": {
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@libsql/client": "^0.17.4",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"hono": "^4",
		"postgres": "^3.4.9",
		"zod": "^4.4.3"
	}
}
