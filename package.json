{
	"name": "codeforge",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"bin": {
		"codeforge": "./dist/main.js"
	},
	"exports": {
		".": "./dist/main.js"
	},
	"scripts": {
		"build": "bun run scripts/build.ts",
		"start": "bun run src/main.ts",
		"serve": "bun run src/main.ts serve",
		"test": "bun test",
		"fix": "bun run check",
		"check": "bun x @biomejs/biome check --fix .",
		"format": "bun x @biomejs/biome format --fix .",
		"lint": "bun x @biomejs/biome lint --fix .",
		"ui:build": "bun run scripts/ui-build.ts",
		"ui:dev": "bun x vite --config vite.ui.config.ts",
		"panda:gen": "panda codegen",
		"cf:build": "bun run scripts/cf-build.ts",
		"cf:dev": "wrangler dev",
		"cf:deploy": "wrangler deploy",
		"cf:types": "wrangler types",
		"better-auth:generate": "better-auth generate --config ./better-auth.config.ts --output ./src/auth/schema.ts"
	},
	"devDependencies": {
		"@better-auth/cli": "^1.4.21",
		"@biomejs/biome": "latest",
		"@hono/vite-build": "^1.11.1",
		"@hono/vite-dev-server": "^0.26.1",
		"@pandacss/dev": "^1.12.0",
		"@pandacss/postcss": "^1.12.0",
		"@ttsc/unplugin": "^0.26.2",
		"@types/bun": "latest",
		"drizzle-kit": "^1.0.0-rc.4",
		"ttsc": "^0.26.2",
		"vite": "^8.2.1"
	},
	"peerDependencies": {
		"typescript": "^7.0.2"
	},
	"overrides": {
		"typescript@>=4.8.4 <6.1.0": "6.0.3"
	},
	"dependencies": {
		"@libsql/client": "^0.17.4",
		"better-auth": "^1.6.28",
		"drizzle-orm": "^1.0.0-rc.4",
		"hono": "^4.13.2",
		"honox": "^0.1.60",
		"isomorphic-git": "^1.41.4",
		"typia": "^13.3.0"
	}
}
