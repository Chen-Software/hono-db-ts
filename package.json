{
	"name": "artefact",
	"module": "src/main.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun --watch src/main.ts",
		"test": "bun test",
		"db:generate": "bun x drizzle-kit generate --dialect sqlite --schema ./src/schema.ts",
		"db:migrate": "bun run scripts/db-migrate.ts",
		"db:seed": "bun run scripts/db-seed.ts",
		"fix": "bun run check",
		"check": "bun x @biomejs/biome check --fix .",
		"format": "bun x @biomejs/biome format --fix .",
		"lint": "bun x @biomejs/biome lint --fix .",
		"start": "bun run src/main.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.5",
		"@types/bun": "latest",
		"drizzle-kit": "^0.31.10"
	},
	"peerDependencies": {
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.2",
		"hono": "^4"
	}
}
