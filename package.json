{
	"name": "artefact",
	"module": "src/main.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"fix": "bun run check",
		"check": "bun x @biomejs/biome check --fix .",
		"format": "bun x @biomejs/biome format --fix .",
		"lint": "bun x @biomejs/biome lint --fix .",
		"build": "bun run scripts/build.ts",
		"start": "bun run src/main.ts",
		"dev": "bun --hot run src/main.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@ttsc/unplugin": "^0.25.0",
		"@types/bun": "latest",
		"ttsc": "^0.25.0",
		"vite": "^8.2.1"
	},
	"peerDependencies": {
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@hono/typia-validator": "^0.1.3",
		"@noble/hashes": "^2.3.0",
		"hono": "^4.13.1",
		"typia": "^13.2.0"
	}
}
