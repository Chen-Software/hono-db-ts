# ── TursoDB (local) configuration — template ─────────────────────────────────
# ✅ LOCAL-ONLY — runs Turso embedded in a local file, similar to `sqlite`.
# NOT deployable to Cloudflare Workers directly (the Worker uses D1/Hyperdrive).
#
# `DATABASE_TYPE` is the unified `turso`; `TURSO_URL` here is a `file:///` local
# URL. (For Turso Cloud use `.env.example.turso-cloud` with a `libsql://` URL.)
#
# Copy to `.env.tursodb` (or rely on this template) and run:
#   bun run dev:tursodb        # run the app against local TursoDB
#   bun run db:migrate:tursodb # apply SQLite migrations to the local file
#   bun run test:tursodb       # run the endpoint tests against local TursoDB
#
# `turso` is SQLite-compatible, so it reuses the SQLite schema + repo.

DATABASE_TYPE=turso

# Local libSQL file URL (embedded file mode).
# libSQL requires an ABSOLUTE path for the `file:///` form (three slashes):
#   file:///absolute/path/to/tursodb.db
TURSO_URL=file:///absolute/path/to/tursodb.db

# Local TursoDB doesn't need an auth token.
# TURSO_AUTH_TOKEN=
